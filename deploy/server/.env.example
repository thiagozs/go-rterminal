# Variaveis da stack. No Portainer, cadastre em "Environment variables" da stack
# (ou use "Load variables from .env file" apontando para uma copia deste arquivo).

# Obrigatorias
DOMAIN=rt.exemplo.com                 # DNS apontando para o servidor do nginx-proxy
LETSENCRYPT_EMAIL=voce@exemplo.com    # avisos de expiracao do Let's Encrypt

# Rede Docker do seu nginx-proxy (Portainer > Networks) e a faixa dela
# (campo Subnet no detalhe da rede). So essa faixa e confiavel para X-Forwarded-For.
PROXY_NETWORK=nginx-proxy
TRUSTED_PROXIES=172.16.0.0/12

# Opcional. Vazio = senha temporaria gerada no primeiro start e mostrada nos logs.
RTERMINAL_ADMIN_PASSWORD=
