# Variaveis da stack. No Portainer, cadastre em "Environment variables" da stack
# (ou use "Load variables from .env file" apontando para uma copia deste arquivo).

# Obrigatoria
DOMAIN=rt.exemplo.com                 # DNS apontando para o servidor do nginx-proxy

# Faixa (Subnet) da rede proxy_net, em Portainer > Networks. Na sua: 10.0.1.0/24.
# So essa faixa e confiavel para X-Forwarded-For.
TRUSTED_PROXIES=10.0.1.0/24

# Imagem do server no Docker Hub (fixe uma tag datada em producao, ex: server-20261126).
SERVER_IMAGE=thiagozs/go-rterminal:server

# Opcional. Vazio = senha temporaria gerada no primeiro start e mostrada nos logs.
RTERMINAL_ADMIN_PASSWORD=

# Opcional. O server precisa rodar no mesmo no do nginx-proxy (que le o docker.sock
# local). Padrao: node.role == manager.
PLACEMENT_CONSTRAINT=node.role == manager

# Transferencia de arquivos pelo painel: true/false e tamanho maximo de um arquivo (MB)
FILE_TRANSFER=true
MAX_TRANSFER_MB=512

# Verificacao em duas etapas. none (padrao), admins ou all: quem for obrigado e nao
# tiver um segundo fator so ve a tela de configuracao ate ativar um.
# O app autenticador (TOTP) funciona sempre. O codigo por e-mail precisa de UM provedor:
REQUIRE_2FA=none
MAIL_FROM=Painel <painel@exemplo.com>   # no Resend, o dominio precisa estar verificado

# Provedor 1: Resend (producao). Preencha a chave e deixe SMTP_HOST vazio.
RESEND_API_KEY=

# Provedor 2: SMTP (ex: Mailpit para testar). Deixe RESEND_API_KEY vazio.
# Mailpit na mesma rede proxy_net:  SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_SECURITY=none
# (o nome do host e o do servico/container do Mailpit; os e-mails aparecem na interface dele)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls                # starttls (587), tls (465) ou none (so relay local, como o Mailpit)
